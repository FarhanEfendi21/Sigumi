<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config untuk SIGUMI.
  Cleartext HTTP hanya dibuka untuk gateway Supabase VPS SIGUMI.
  Koneksi lain tetap mengikuti kebijakan HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Percaya semua sertifikat CA yang sudah terinstall di sistem -->
            <certificates src="system" />
            <!-- Percaya juga CA dari pengguna, berguna untuk testing di corporate network -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Izin eksplisit untuk domain Supabase utama SIGUMI -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">supabase.co</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Pengecualian sementara untuk Supabase VPS pada port HTTP 8000.
         Network Security Config membatasi host; port dibatasi di SupabaseConfig. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">187.53.141.200</domain>
    </domain-config>
</network-security-config>
